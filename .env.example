# NexTool Fit email conversion MVP

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Server-only key. Never expose this as NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional; defaults to fitness_leads
SUPABASE_FITNESS_LEADS_TABLE=fitness_leads

# Brevo API key for transactional email sending
BREVO_API_KEY=

# Verified sender in Brevo
FITNESS_EMAIL_FROM="NexTool Fit <nextool.online@gmail.com>"

# Private dashboard token for /pt/fitness/dashboard?token=...
FITNESS_DASHBOARD_TOKEN=
